                    "type": "object",
                    "properties": {
                        "message": { "type": "string" }
                    }
                },
                "errCode": { "type": "string" },
                "errMsg": { "type": "string" },
                "suggestion": { "type": "string" }
            }
        }
    },
    "hotspot-disable": {
        "description": "Disable the WiFi hotspot",
        "requirePermissions": [
            "ohos.permission.MANAGE_WIFI_HOTSPOT",
            "ohos.permission.GET_WIFI_INFO"
        ],
        "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "type": { "type": "string" },
                "status": { "type": "string" },
                "data": {
                    "type": "object",
                    "properties": {
                        "message": { "type": "string" }
                    }
                },
                "errCode": { "type": "string" },
                "errMsg": { "type": "string" },
                "suggestion": { "type": "string" }
            }
        }
    },
    "hotspot-config-set": {
        "description": "Set WiFi hotspot SSID, password or band. Provide at least one of ssid, preSharedKey or band. preSharedKey is 8~63 characters; band is one of 2.4G or 5G.",
        "requirePermissions": [
            "ohos.permission.SET_WIFI_INFO",
            "ohos.permission.GET_WIFI_INFO",
            "ohos.permission.SET_WIFI_CONFIG",
            "ohos.permission.GET_WIFI_CONFIG"
        ],
        "inputSchema": {
            "type": "object",
            "properties": {
                "ssid": { "type": "string" },
                "preSharedKey": { "type": "string" },
                "band": { "type": "string" }
            },
            "required": []
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "type": { "type": "string" },
                "status": { "type": "string" },
                "data": {
                    "type": "object",
                    "properties": {
                        "ssid": { "type": "string" },
                        "band": { "type": "string" },
                        "message": { "type": "string" }
                    }
                },
                "errCode": { "type": "string" },
                "errMsg": { "type": "string" },
                "suggestion": { "type": "string" }
            }
        }
    },
    "hotspot-config-get": {
        "description": "Get current WiFi hotspot configuration and running state, including supported bands",
        "requirePermissions": [
            "ohos.permission.GET_WIFI_INFO",
            "ohos.permission.GET_WIFI_CONFIG"
        ],
        "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "type": { "type": "string" },
                "status": { "type": "string" },
                "data": {
                    "type": "object",
                    "properties": {
                        "active": { "type": "boolean" },
                        "state": { "type": "string" },
                        "ssid": { "type": "string" },
                        "band": { "type": "string" },
                        "channel": { "type": "number" },
                        "maxConn": { "type": "number" },
                        "ipAddress": { "type": "string" },
                        "hasPassword": { "type": "boolean" },
                        "validBands": {
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    }
                },
                "errCode": { "type": "string" },
                "errMsg": { "type": "string" },
                "suggestion": { "type": "string" }
            }
        }
    },
    "hotspot-blocklist-get": {
        "description": "List devices currently blocklisted from the WiFi hotspot",
        "requirePermissions": [
            "ohos.permission.MANAGE_WIFI_HOTSPOT",
            "ohos.permission.GET_WIFI_INFO"
        ],
        "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "type": { "type": "string" },
                "status": { "type": "string" },
                "data": {
                    "type": "object",
                    "properties": {
                        "count": { "type": "number" },
                        "stations": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "bssid": { "type": "string" },
                                    "ipAddr": { "type": "string" },
                                    "deviceName": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "errCode": { "type": "string" },
                "errMsg": { "type": "string" },
                "suggestion": { "type": "string" }
            }
        }
    },
    "wifi-exception":{
        "description":"List or clear WiFi exception records grouped by SSID",
        "requirePermissions":[
            "ohos.permission.cli.MANAGE_WIFI_SCAN"
        ],
        "inputSchema":{
            "type":"object",
            "properties":{
                "clear":{"type":"boolean"},
                "ssid":{"type":"string"},
                "category":{"type":"string"},
                "reason":{"type":"number"},
                "per-ap":{"type":"number"}
            },
            "required":[]
        },
        "outputSchema":{
            "type":"object",
            "properties":{
                "type":{"type":"string"},
                "status":{"type":"string"},
                "data":{
                    "type":"object",
                    "properties":{
                        "exceptions":{
                            "type":"array",
                            "items":{
                                "type":"object",
                                "properties":{
                                    "ssid":{"type":"string"},
                                    "faults":{
                                        "type":"array",
                                        "items":{
                                            "type":"object",
                                            "properties":{
                                                "timestamp":{"type":"number"},
                                                "timeReadable":{"type":"string"},
                                                "reasonCode":{"type":"number"},
                                                "reason":{"type":"string"},
                                                "category":{"type":"string"},
                                                "suggestion":{"type":"string"}
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "count":{"type":"number"}
                    }
                },
                "errCode":{"type":"string"},
                "errMsg":{"type":"string"},
                "suggestion":{"type":"string"}
            }   
        }
    }
    },
    "eventTypes": [],
